# 2. Edit .env
POSTGRES_PASSWORD=password
TOKEN_SECRET=secret
JWT_SALT=salt_data
PGADMIN_DEFAULT_EMAIL=pgadmin_email_for_docker
PGADMIN_DEFAULT_PASSWORD=Password123
# Change SEED_DB and RUN_MIGRATIONS to true if you want to seed the database and run migrations when the container starts. Set them to false if you want to skip these steps.
SEED_DB=false
RUN_MIGRATIONS=false
DATABASE_URL=postgresql://${user}:${pass}@${hostname}:${port}/${dbname}?schema=public&connection_limit=5

